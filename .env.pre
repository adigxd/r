# ./

# light
LIT_POS=0.0,0.0,0.0 # position of light
LIT_RAD=64 # radius of light
LIT_INT=1 # intensity of light
LIT_COL=0.875, 1.0, 1.0 # color of light

# map*.py
SED=7987523224469270 # seed for map generation
BLC_SIZ=32 # size of each block texture in the texture atlas
TEX_SIZ=512 # size of the texture atlas
DIR_MAP=./DIR-Maps # directory for map files
MAP=0.json # map type (DEBUG, EARTH, ETC.)

# main.py
THD_CNT=4 # thread count for chunks
RES_X=1024 # resolution width
RES_Y=768 # resolution height
TIC=128 # ticks per second
FOV=90.0 # field of view
SEE_MIN=0.1 # minimum view distance
SEE_MAX=4096.0 # maximum view distance
SEN=0.08 # mouse sensitivity
LIN_WID=1.0 # glLineWidth
COL_BKG=0.5, 0.7, 0.7 # background color
POS=0.0,16.0,0.0 # initial position
SPD=0.01 # speed
SPD_MAG=4.0 # speed multiplier when sprinting
WID=0.5 # player width
HIT=1.5 # player height
ACC_D=0.001 # deceleration
JMP_MAG=0.05 # jump magnitude

# main.py / texture paths
PTH_TEX=./DIR-Resources/IMG-Texture.png # texture atlas for blocks

# main.py / shader paths
PTH_SHA_V=./DIR-SHADER/SHA_V_LIT.glsl # vertex shader
PTH_SHA_F=./DIR-SHADER/SHA_F-3D_LIT_0.glsl # fragment shader
PTH_SHA_V_PST=./DIR-SHADER/SHA_V_PST.glsl # post-processing vertex shader
PTH_SHA_F_PST_DEF=./DIR-SHADER/SHA_F_PST-DEFAULT.glsl # post-processing fragment shader (default)
PTH_SHA_F_PST_0=./DIR-SHADER/SHA_F_PST-EDGE_DETECT.glsl # post-processing fragment shader (edge detect)
PTH_SHA_F_PST_1=./DIR-SHADER/SHA_F_PST-DITHER.glsl # post-processing fragment shader (dither)

# main.py / general paths
DIR_SSM=./DIR-Screenshots

# main.py / debug
DBG_KIN=0 # debug kinematics mode (0: fly, no physics, 1: normal)