# settings that are the same for every map (map-specific ones live in the map file, see maps/)
# this file is the default; to change something for yourself, put just that line in a file called .env (not tracked by git) and it overrides the line here

# window
WIDTH=1280 # window width in pixels when not fullscreen (kept between 1280 and 3840, and never bigger than your screen)
HEIGHT=720 # window height in pixels when not fullscreen (kept between 720 and 2160, and never bigger than your screen)
FULLSCREEN=true # start in fullscreen (F11 toggles it while playing); fullscreen always uses the resolution of your screen, so WIDTH and HEIGHT don't apply to it
MAX_FPS=128 # frame rate cap
TICK_RATE=64 # physics updates per second (movement, gravity, collisions); it doesn't depend on the frame rate: frames in between are smoothed
MAX_FRAME_TIME=0.25 # seconds; after a freeze longer than this (dragging the window, ...) the physics doesn't try to catch up on all of it, it just carries on
COLLISION_STEP=0.375 # blocks (0 to 1); the player is moved at most this far at a time while checking for blocks in the way, so a fast player can't go through a block or a thin floor (smaller is safer for very fast movement, a bigger one is slightly faster; keep it below 0.5, the width of the player)
FOV=90.0 # field of view
NEAR_CLIP=0.1 # minimum view distance
FAR_CLIP=4096.0 # maximum view distance; chunks (16x16x16 blocks) further away than this from the camera aren't drawn at all
MAX_LIGHTS=32 # most lights that can light the screen at the same time; a map can have any number of lights, every frame the ones that can light something visible are picked (the brightest, biggest and closest ones if there are more than this), and a graphics card that can't take this many is given fewer
LIGHT_FADE_TIME=0.25 # seconds; when more lights matter than MAX_LIGHTS and the choice of which ones to use changes, a light fades in or out over this long instead of popping on / off (0 = no fading)
LIGHT_FADE_SHARE=0.125 # share of the MAX_LIGHTS places (0 to 0.5) kept free for lights that are fading out; at most that many lights can change at a time
LIGHT_STICKINESS=1.3 # a light that already has a place has to be this many times worse than a newcomer to lose it (1 = the best always win, a bit more stops lights from swapping back and forth)
LIGHT_CELL_SIZE=64 # blocks; the lights of a map are sorted into cubes of this size to find the ones in view quickly (only matters for speed, with thousands of lights)
REND_MAX_BLOCKS=4000000 # the most blocks one rend command may work on (a command that would do more says so and does nothing)
REND_UNDO_BLOCKS=8000000 # the most changed blocks the undo steps of rend remember all together (the oldest steps are forgotten first); about 11 bytes per block
CHAT_FONT=./resources/fonts/JetBrainsMonoNL-Regular.ttf # font of the chat (JetBrains Mono, SIL Open Font License)
CHAT_FONT_SIZE=22 # size of the chat text in pixels on a window 1080 high (it grows and shrinks with the window)
CHAT_LINES=10 # lines of the chat shown while it is closed (messages fade out)
CHAT_HISTORY=300 # lines of the chat that are remembered, to scroll back with Page Up / Page Down
CHAT_FADE_TIME=8.0 # seconds a message stays on the screen while the chat is closed
CHAT_WIDTH=0.55 # width of the chat as a share of the window (0 to 1)
GUI_WIDTH=0.3 # width of the menu of effects (] opens and closes it) as a share of the window (0 to 1; on a window 1080 high it is never narrower than 440 pixels)
GUI_ALPHA=0.9 # how solid the black of the menu is (0 to 1; 1 hides what is behind it)
GUI_FONT_SIZE=18 # size of the text of the menu in pixels on a window 1080 high (it grows and shrinks with the window)
MOUSE_SENSITIVITY=0.08 # mouse sensitivity
LINE_WIDTH=1.0 # glLineWidth (wireframe)
CHUNK_SIZE=16 # blocks (a power of 2); the world is drawn in cubes of CHUNK_SIZE^3 blocks, and a cube is drawn or skipped as a whole (smaller skips more precisely, bigger needs fewer checks)
GLASS_SORT_DISTANCE=0.5 # blocks; see-through faces are sorted again whenever the camera has moved this far (smaller is more exact, bigger is faster)
LOADING_BAR_FPS=30 # how often the loading bar is redrawn while the map builds (each redraw takes a little time from the build)
LOADING_BAR_WIDTH=0.3 # width of the loading bar as a share of the width of the window (0 to 1)

# textures
ATLAS_PATH=./resources/atlas.png # texture atlas for blocks
TILE_SIZE=32 # size of each block texture (tile) in the texture atlas
ATLAS_SIZE=512 # size of the texture atlas
MIPMAPS=true # smooth far away textures instead of letting them shimmer

# shaders
BLOCK_VERTEX_SHADER=./shaders/block.vert # vertex shader
BLOCK_FRAGMENT_SHADER=./shaders/block.frag # fragment shader (with lighting)
POST_VERTEX_SHADER=./shaders/post.vert # post-processing vertex shader
UI_VERTEX_SHADER=./shaders/ui.vert # draws the chat (rectangles and text)
UI_FRAGMENT_SHADER=./shaders/ui.frag
LINE_VERTEX_SHADER=./shaders/line.vert # draws the box of the rend selection
LINE_FRAGMENT_SHADER=./shaders/line.frag
SHADER_DEFAULTS=./shaders/defaults.json # the built-in full-screen shaders (read only; Backslash goes through them in the order they are written, the first one is on at the start)
SHADER_DIR=./shaders/custom # your own shaders (made with .shader save, one file each; they come after the built-in ones, in alphabetical order, and work on every map)
FX_UNDO_STEPS=100 # how many changes to the effects on the screen can be undone (.fx undo)

# paths
SCREENSHOT_DIR=./screenshots # screenshots
MUSIC_DIR=./resources/music # folder music files are looked up in (a map picks its file with "music")

# audio
MIXER_FREQUENCY=44100 # sample rate for audio playback
MIXER_SIZE=-16 # sample size in bits (negative means signed samples)
MIXER_CHANNELS=2 # stereo playback
MIXER_BUFFER=2048 # mixer buffer size in samples
MUSIC_VOLUME=0.25 # master music volume (0.0 to 1.0)
