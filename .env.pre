# ./

# light
LIT_POS=0.0,0.0,0.0 # position of light
LIT_RAD=16 # radius of light
LIT_INT=1 # intensity of light
LIT_COL=0.5, 0.875, 1.0 # color of light

# map*.py
SED=7987523224469270 # seed for map generation
BLC_SIZ=32 # size of each block texture in the texture atlas
TEX_SIZ=512 # size of the texture atlas
DIR_MAP=./DIR-Maps # directory for map files
MAP=1.json # map type (DEBUG, EARTH, ETC.)

# main.py
THD_CNT=4 # thread count for chunks
RES_X=1920 # resolution width
RES_Y=1080 # resolution height
TIC=128 # ticks per second
FOV=90.0 # field of view
SEE_MIN=0.1 # minimum view distance
SEE_MAX=4096.0 # maximum view distance
SEN=0.08 # mouse sensitivity
LIN_WID=1.0 # glLineWidth
COL_BKG=0.0078125,0.0078125,0.0078125 # background color
POS=0.0,2.0,0.0 # initial position
SPD=8 # speed
SPD_MAG=4.0 # speed multiplier when sprinting
WID=0.5 # player width
HIT=1.5 # player height
ACC_D=24 # deceleration
JMP_MAG=6 # jump magnitude

# main.py / texture paths
PTH_TEX=./DIR-Resources/IMG-Texture.png # texture atlas for blocks

# main.py / shader paths
PTH_SHA_V=./DIR-Shaders/SHA_V.glsl # vertex shader
PTH_SHA_F=./DIR-Shaders/SHA_F.glsl # fragment shader (with lighting)
PTH_SHA_V_PST=./DIR-Shaders/SHA_V-PST.glsl # post-processing vertex shader
PTH_SHA_F_PST_DEF=./DIR-Shaders/SHA_F-PST-0.glsl # post-processing fragment shader (default)
PTH_SHA_F_PST_0=./DIR-Shaders/SHA_F-PST-EdgeDetect.glsl # post-processing fragment shader (edge detect)
PTH_SHA_F_PST_1=./DIR-Shaders/SHA_F-PST-Dither.glsl # post-processing fragment shader (dither)

# main.py / general paths
DIR_SSM=./DIR-Screenshots

# main.py / music
PTH_MSC=./DIR-Resources/DIR-Music/1.mp3
MIX_FRQ=44100 # sample rate for audio playback
MIX_SIZ=-16 # sample size in bits (negative means signed samples)
MIX_CNL_CNT=2 # stereo playback
MIX_BUF=2048 # mixer buffer size in samples
MIX_VOL=0.5 # master music volume (0.0 to 1.0)

# main.py / debug
DBG_KIN=1 # debug kinematics mode (0: fly, no physics, 1: normal)